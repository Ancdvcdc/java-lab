<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle != null ? pageTitle + " · Lab 9 EAUT" : "Lab 9 - EAUT" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body>
<div class="app-shell">

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="mark">EAUT</div>
            <div>
                <div class="name">Công nghệ Java</div>
                <span class="subtitle">LAB 09</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="${pageContext.request.contextPath}/index.jsp" class="<%= "home".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 10.5 12 4 21 10.5"/><path d="M5.5 9.5V20h5v-5.5h3V20h5V9.5"/></svg>
                Trang chủ
            </a>

            <span class="nav-label">Đào tạo</span>
            <a href="${pageContext.request.contextPath}/sinh-vien" class="<%= "sinhvien".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c0-4.1 3.4-6.6 7.5-6.6s7.5 2.5 7.5 6.6"/></svg>
                Sinh viên
            </a>
            <a href="${pageContext.request.contextPath}/lop-hoc" class="<%= "lophoc".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.3" y="3.3" width="7.2" height="7.2" rx="1.4"/><rect x="13.5" y="3.3" width="7.2" height="7.2" rx="1.4"/><rect x="3.3" y="13.5" width="7.2" height="7.2" rx="1.4"/><rect x="13.5" y="13.5" width="7.2" height="7.2" rx="1.4"/></svg>
                Lớp học
            </a>
            <a href="${pageContext.request.contextPath}/mon-hoc" class="<%= "monhoc".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.2c-2-1.4-4.8-1.9-7.7-1V18c2.9-0.9 5.7-0.4 7.7 1 2-1.4 4.8-1.9 7.7-1V5.2c-2.9-0.9-5.7-0.4-7.7 1z"/><line x1="12" y1="6.2" x2="12" y2="19"/></svg>
                Môn học
            </a>
            <a href="${pageContext.request.contextPath}/diem" class="<%= "diem".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="12.5" width="3.4" height="7.5" rx="0.6"/><rect x="10.3" y="6.5" width="3.4" height="13.5" rx="0.6"/><rect x="16.6" y="15.5" width="3.4" height="4.5" rx="0.6"/></svg>
                Điểm
            </a>

            <span class="nav-label">Kho dữ liệu khác</span>
            <a href="${pageContext.request.contextPath}/sach" class="<%= "sach".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 4.3h11.4c0.9 0 1.6 0.7 1.6 1.6v12.8c0 0.5-0.4 0.9-0.9 0.9H7.1c-0.9 0-1.6-0.7-1.6-1.6V4.3z"/><line x1="5.5" y1="4.3" x2="5.5" y2="17.7"/></svg>
                Sách
            </a>
            <a href="${pageContext.request.contextPath}/san-pham" class="<%= "sanpham".equals(activeMenu) ? "active" : "" %>">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3.3 7.5L12 3l8.7 4.5L12 12z"/><path d="M3.3 7.5v9L12 21l8.7-4.5v-9"/><line x1="12" y1="12" x2="12" y2="21"/></svg>
                Sản phẩm
            </a>
        </nav>

        <div class="sidebar-foot">
            Bộ môn CNPM · Khoa CNTT<br>Đại học Công nghệ Đông Á
        </div>
    </aside>

    <main class="main">
        <div class="topbar">
            <button class="menu-btn" onclick="toggleSidebar(true)" aria-label="Mở menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <strong style="font-family:var(--font-display);"><%= pageTitle != null ? pageTitle : "" %></strong>
        </div>
